{
  "listen": "0.0.0.0:8092",
  "public_model": "qwen3.8-27b",
  "context_length": 240000,
  "probe_timeout": 1.0,
  "probe_interval": 2.0,
  "request_timeout": 600,
  "idle_seconds": 600,
  "start_timeout": 180,
  "fail_cooldown": 30,
  "registry": {
    "server": "http://directory.example:8096",
    "interval_seconds": 30
  },
  "backends": [
    {
      "name": "fast-gpu",
      "origin": "http://127.0.0.1:18090",
      "command": ["/opt/ninfer/bin/serve-fast-gpu"],
      "gpu": "fast-gpu",
      "weakness": 10,
      "capabilities": ["text"],
      "slots": 2
    },
    {
      "name": "workstation",
      "origin": "http://workstation.example:8092",
      "remote": true,
      "machine_id": "id-from-that-machine",
      "capabilities": ["text", "vision", "image"],
      "weakness": 0,
      "slots": 3
    }
  ]
}
